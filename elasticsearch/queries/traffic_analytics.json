{
  "size": 0,
  "aggs": {
    "top_src": {
      "terms": {
        "field": "src_ip",
        "size": 10
      }
    },
    "top_ports": {
      "terms": {
        "field": "dst_port",
        "size": 10
      }
    },
    "protocols": {
      "terms": {
        "field": "protocol"
      }
    },
    "bytes_over_time": {
