# Copy this file to ".env" and change the passwords:
#   cp .env.example .env
COMPOSE_PROJECT_NAME=cyberthreat

# ---------------- MongoDB ----------------
MONGO_DB=threatdb
MONGO_ROOT_USERNAME=threat_admin
MONGO_ROOT_PASSWORD=change_me_mongo_password
MONGO_HOST=mongodb
MONGO_PORT=27017

# ---------------- Django ----------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-1234567890
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Default accounts created on first start (change these!)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=Admin@12345
DJANGO_ANALYST_USERNAME=analyst
DJANGO_ANALYST_PASSWORD=Analyst@12345
# Shared secret used by the log generator to talk to Django
SERVICE_API_TOKEN=change-me-service-token-abc123
DJANGO_INTERNAL_URL=http://django:8000

# ---------------- Kafka ----------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PARTITIONS=3

# ---------------- Elasticsearch ----------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------------- Hadoop HDFS ----------------
HDFS_NAMENODE_URI=hdfs://namenode:8020
HDFS_WEBHDFS_URL=http://namenode:9870
HDFS_USER=hadoop
HDFS_BASE_PATH=/cybersecurity

# ---------------- Spark ----------------
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1200m
SPARK_TRAIN_DRIVER_MEMORY=2g
SPARK_TRIGGER_SECONDS=15
SPARK_RAW_TRIGGER_SECONDS=60
SPARK_MAX_OFFSETS_PER_TRIGGER=20000
SPARK_UI_URL=http://spark-streaming:4040
FEATURE_WINDOW_SECONDS=10
ALERT_DEDUP_WINDOW_MINUTES=10
# Set to 1 to retrain models on the next "docker compose up"
FORCE_RETRAIN=0
TRAINING_EVENTS_TARGET=150000

# ---------------- Log generator ----------------
GENERATOR_DEFAULT_RATE=8
GENERATOR_AUTOSTART=0
