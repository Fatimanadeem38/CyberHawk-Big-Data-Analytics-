# Hadoop configuration passed to the apache/hadoop Docker image.
# The image turns "FILE.XML_property=value" into entries in that XML file.
CORE-SITE.XML_fs.default.name=hdfs://namenode:8020
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.replication=1
# Store HDFS data on Docker volumes (kept after "docker compose down")
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
# Local single-user project: disable HDFS permission checks so Spark
# (user "spark") and WebHDFS (user "hadoop") can share the folders.
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# Keep the datanode from refusing writes on a small laptop disk
HDFS-SITE.XML_dfs.datanode.du.reserved=0
# Single-node demo: leave safe mode straight after start-up instead of
# waiting for every block report (otherwise "init" can time out).
HDFS-SITE.XML_dfs.namenode.safemode.threshold-pct=0
HDFS-SITE.XML_dfs.namenode.safemode.extension=0
